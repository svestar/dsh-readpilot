{
  "name": "dsh-reader",
  "version": "0.1.0",
  "private": true,
  "description": "Read TXT, Markdown, EPUB and PDF books with an AI companion session per book.",
  "type": "module",
  "main": "index.js",
  "dependencies": {
    "@napi-rs/canvas": "^1.1.0",
    "htmlparser2": "^10.1.0",
    "jszip": "^3.10.2",
    "linkedom": "^0.18.15",
    "pdfjs-dist": "^6.5.438"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "src/**/*.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  }
}
