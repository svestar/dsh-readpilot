{
  "name": "dsh-readpilot",
  "version": "0.2.1",
  "description": "AI-assisted reading for DeepSeek Harness: TXT, Markdown, EPUB and PDF with a companion session, notes, memory and export.",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": ">=22.18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/svestar/dsh-readpilot.git"
  },
  "homepage": "https://github.com/svestar/dsh-readpilot#readme",
  "bugs": {
    "url": "https://github.com/svestar/dsh-readpilot/issues"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "reader",
    "epub",
    "pdf",
    "ai"
  ],
  "author": "svestar",
  "dependencies": {
    "@napi-rs/canvas": "^1.1.0",
    "htmlparser2": "^10.1.0",
    "jszip": "^3.10.2",
    "linkedom": "^0.18.15",
    "pdfjs-dist": "^6.5.438"
  },
  "exports": {
    ".": "./dist/index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "dist/**/*.js",
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "pnpm run clean && tsc -p tsconfig.build.json && node scripts/build-client.ts",
    "prepack": "pnpm run build",
    "pretest": "pnpm run build:client",
    "build:client": "node scripts/build-client.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"tests/*.test.ts\""
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  }
}
